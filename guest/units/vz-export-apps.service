[Unit]
Description=Publish installed apps' names and icons to the Mac (Dock icons)
Requires=mnt-vzgpu.mount
After=mnt-vzgpu.mount

[Service]
Type=oneshot
Environment=VZ_SHARE=/mnt/vzgpu
# Let a package transaction finish writing its files first (a path trigger fires on the
# first change, and changes during the run would otherwise be missed).
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/vz-export-apps

[Install]
WantedBy=multi-user.target
