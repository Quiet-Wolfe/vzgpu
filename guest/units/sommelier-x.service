# User service: a shared X server (DISPLAY=:0) for X11-only apps started without x11-run.
# Its apps share one Wayland connection, so on the Mac they share one Dock tile; x11-run
# gives an X11 app its own.
[Unit]
Description=sommelier: shared Xwayland for X11 apps
After=sommelier.service

[Service]
Environment=SOMMELIER_FULL_COPY=1
ExecStart=/usr/local/bin/sommelier -X --scale=2 --virtgpu-channel --xwayland-path=/usr/bin/Xwayland --x-display=0 --no-exit-with-child /usr/local/bin/vz-x11-session /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
