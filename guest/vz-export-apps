#!/bin/sh
# vz-export-apps — publish installed apps to the Mac: Dock icons (vzcomp) and the launchers in
# /Applications/<distro>/ (vzgpu sync-apps). For every launchable .desktop file writes
#   <share>/apps/<desktop-id>/{name, desktop, icon.svg|icon.png}
# (desktop = the .desktop file's guest path, launched with `gio launch`), removes apps that are
# gone, and touches <share>/apps/.stamp so the Mac's watcher fires.
# The share is the VMM's virtiofs tag "vzgpu" (~/Library/Application Support/vzgpu/share).
SHARE=${VZ_SHARE:-/mnt/vzgpu}
mkdir -p "$SHARE"
mountpoint -q "$SHARE" || mount -t virtiofs vzgpu "$SHARE" 2>/dev/null || { echo "vz-export-apps: no vzgpu share" >&2; exit 1; }
mkdir -p "$SHARE/apps"

find_icon() {  # $1 = Icon= value
    case "$1" in /*) [ -f "$1" ] && { echo "$1"; return; } ;; esac
    for base in /usr/share/icons/hicolor /usr/share/icons/Adwaita; do
        for f in "$base/scalable/apps/$1.svg" "$base/512x512/apps/$1.png" "$base/256x256/apps/$1.png" \
                 "$base/128x128/apps/$1.png" "$base/96x96/apps/$1.png" "$base/64x64/apps/$1.png" \
                 "$base/48x48/apps/$1.png"; do
            [ -f "$f" ] && { echo "$f"; return; }
        done
    done
    for f in "/usr/share/pixmaps/$1.svg" "/usr/share/pixmaps/$1.png"; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
}

entry() {  # $1 = key, $2 = .desktop file: value in the [Desktop Entry] group
    sed -n '/^\[Desktop Entry\]/,/^\[/{s/^'"$1"'=//p}' "$2" | head -n1
}

keep=" "
for desktop in /usr/share/applications/*.desktop /usr/local/share/applications/*.desktop; do
    [ -f "$desktop" ] || continue
    # Only what a menu would show: no hidden entries, no terminal programs.
    [ "$(entry NoDisplay "$desktop")" = true ] && continue
    [ "$(entry Hidden "$desktop")" = true ] && continue
    [ "$(entry Terminal "$desktop")" = true ] && continue
    [ "$(entry Type "$desktop")" = Application ] || continue
    id=$(basename "$desktop" .desktop)
    keep="$keep$id "
    dir="$SHARE/apps/$id"
    [ "$dir/desktop" -nt "$desktop" ] && continue  # already exported and unchanged
    mkdir -p "$dir"
    rm -f "$dir/icon.svg" "$dir/icon.png"
    file=$(find_icon "$(entry Icon "$desktop")")
    [ -n "$file" ] && cp "$file" "$dir/icon.${file##*.}"
    name=$(entry Name "$desktop")
    printf '%s\n' "${name:-$id}" > "$dir/name"
    printf '%s\n' "$desktop" > "$dir/desktop"
done

# Apps that were uninstalled (or became hidden) disappear from the Mac too.
for dir in "$SHARE"/apps/*/; do
    id=$(basename "$dir")
    case "$keep" in *" $id "*) ;; *) rm -rf "$dir" ;; esac
done
touch "$SHARE/apps/.stamp"
