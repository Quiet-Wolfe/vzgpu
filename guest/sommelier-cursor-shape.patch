diff --git a/sommelier-cursor-shape.cc b/sommelier-cursor-shape.cc
new file mode 100644
index 0000000..2971910
--- /dev/null
+++ b/sommelier-cursor-shape.cc
@@ -0,0 +1,143 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// wp_cursor_shape_v1 pass-through: clients name their cursor ("text",
+// "pointer", "ew-resize", ...) instead of drawing it, so the host compositor
+// can show its own native cursor. Serials are forwarded unchanged, as
+// sl_host_pointer_set_cursor does for wl_pointer.set_cursor.
+
+#include "sommelier.h"  // NOLINT(build/include_directory)
+
+#include <assert.h>
+#include <stdlib.h>
+
+#include "cursor-shape-v1-client-protocol.h"  // NOLINT(build/include_directory)
+#include "cursor-shape-v1-server-protocol.h"  // NOLINT(build/include_directory)
+
+struct sl_host_cursor_shape_manager {
+  struct sl_cursor_shape_manager* cursor_shape_manager;
+  struct wl_resource* resource;
+  struct wp_cursor_shape_manager_v1* proxy;
+};
+
+struct sl_host_cursor_shape_device {
+  struct wl_resource* resource;
+  struct wp_cursor_shape_device_v1* proxy;  // null for tablet tools
+};
+
+static void sl_cursor_shape_device_destroy(struct wl_client* client,
+                                           struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+static void sl_cursor_shape_device_set_shape(struct wl_client* client,
+                                             struct wl_resource* resource,
+                                             uint32_t serial,
+                                             uint32_t shape) {
+  struct sl_host_cursor_shape_device* host =
+      static_cast<sl_host_cursor_shape_device*>(
+          wl_resource_get_user_data(resource));
+  if (host->proxy)
+    wp_cursor_shape_device_v1_set_shape(host->proxy, serial, shape);
+}
+
+static const struct wp_cursor_shape_device_v1_interface
+    sl_cursor_shape_device_implementation = {sl_cursor_shape_device_destroy,
+                                             sl_cursor_shape_device_set_shape};
+
+static void sl_destroy_host_cursor_shape_device(struct wl_resource* resource) {
+  struct sl_host_cursor_shape_device* host =
+      static_cast<sl_host_cursor_shape_device*>(
+          wl_resource_get_user_data(resource));
+  if (host->proxy)
+    wp_cursor_shape_device_v1_destroy(host->proxy);
+  wl_resource_set_user_data(resource, nullptr);
+  delete host;
+}
+
+static struct sl_host_cursor_shape_device* sl_create_device(
+    struct wl_client* client, struct wl_resource* manager, uint32_t id) {
+  struct sl_host_cursor_shape_device* device =
+      new sl_host_cursor_shape_device();
+  device->resource =
+      wl_resource_create(client, &wp_cursor_shape_device_v1_interface,
+                         wl_resource_get_version(manager), id);
+  wl_resource_set_implementation(device->resource,
+                                 &sl_cursor_shape_device_implementation, device,
+                                 sl_destroy_host_cursor_shape_device);
+  return device;
+}
+
+static void sl_cursor_shape_manager_destroy(struct wl_client* client,
+                                            struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+static void sl_cursor_shape_manager_get_pointer(
+    struct wl_client* client,
+    struct wl_resource* resource,
+    uint32_t id,
+    struct wl_resource* pointer_resource) {
+  struct sl_host_cursor_shape_manager* host =
+      static_cast<sl_host_cursor_shape_manager*>(
+          wl_resource_get_user_data(resource));
+  struct sl_host_pointer* host_pointer = static_cast<sl_host_pointer*>(
+      wl_resource_get_user_data(pointer_resource));
+  struct sl_host_cursor_shape_device* device =
+      sl_create_device(client, resource, id);
+  device->proxy =
+      wp_cursor_shape_manager_v1_get_pointer(host->proxy, host_pointer->proxy);
+}
+
+static void sl_cursor_shape_manager_get_tablet_tool_v2(
+    struct wl_client* client,
+    struct wl_resource* resource,
+    uint32_t id,
+    struct wl_resource* tablet_tool) {
+  // Tablet tools keep their drawn cursors; the device accepts and ignores
+  // shapes.
+  sl_create_device(client, resource, id);
+}
+
+static const struct wp_cursor_shape_manager_v1_interface
+    sl_cursor_shape_manager_implementation = {
+        sl_cursor_shape_manager_destroy, sl_cursor_shape_manager_get_pointer,
+        sl_cursor_shape_manager_get_tablet_tool_v2};
+
+static void sl_destroy_host_cursor_shape_manager(struct wl_resource* resource) {
+  struct sl_host_cursor_shape_manager* host =
+      static_cast<sl_host_cursor_shape_manager*>(
+          wl_resource_get_user_data(resource));
+  wp_cursor_shape_manager_v1_destroy(host->proxy);
+  wl_resource_set_user_data(resource, nullptr);
+  delete host;
+}
+
+static void sl_bind_host_cursor_shape_manager(struct wl_client* client,
+                                              void* data,
+                                              uint32_t version,
+                                              uint32_t id) {
+  struct sl_context* ctx = static_cast<sl_context*>(data);
+  struct sl_cursor_shape_manager* manager = ctx->cursor_shape_manager;
+  struct sl_host_cursor_shape_manager* host =
+      new sl_host_cursor_shape_manager();
+  version = MIN(version, manager->version);
+  host->cursor_shape_manager = manager;
+  host->resource = wl_resource_create(
+      client, &wp_cursor_shape_manager_v1_interface, version, id);
+  wl_resource_set_implementation(host->resource,
+                                 &sl_cursor_shape_manager_implementation, host,
+                                 sl_destroy_host_cursor_shape_manager);
+  host->proxy = static_cast<wp_cursor_shape_manager_v1*>(wl_registry_bind(
+      wl_display_get_registry(ctx->display), manager->id,
+      &wp_cursor_shape_manager_v1_interface, version));
+  wp_cursor_shape_manager_v1_set_user_data(host->proxy, host);
+}
+
+struct sl_global* sl_cursor_shape_manager_global_create(
+    struct sl_context* ctx) {
+  return sl_global_create(ctx, &wp_cursor_shape_manager_v1_interface,
+                          ctx->cursor_shape_manager->version, ctx,
+                          sl_bind_host_cursor_shape_manager);
+}
